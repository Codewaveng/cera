# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<db_username>:qn2tC9F5CYaNYKZY@cluster0.54qcymz.mongodb.net/

# JWT secret — make this long and random
JWT_SECRET=your_super_secret_jwt_key_change_this

# JWT expiry
JWT_EXPIRES_IN=30d

# Server port
PORT=5000

# Firebase Admin SDK service account JSON (path to the file)
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# CoinGecko (free — no key needed for basic tier)
# Leave blank unless you have a paid API key
COINGECKO_API_KEY=

# App name (used in notifications)
APP_NAME=CERA
